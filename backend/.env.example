# Copy this file to ".env" and fill in your own values.
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=localbiz
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:3000

# Gmail + App Password (leave empty to run without real emails)
EMAIL_USER=
EMAIL_PASS=
ADMIN_NOTIFY_EMAIL=admin@localbiz.pk

# true = show OTP on screen when real email is not available (demo only)
# false = never show it
ALLOW_DEV_OTP=true
